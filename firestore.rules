rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function writeNotHuge() {
      return request.resource == null
        || request.resource.size() < 900000;
    }

    function valisDocAllowed(docId) {
      return docId in [
        'db_v42',
        'aviso',
        'manutencao',
        'plantoes_backup',
        'dev_log',
        'cadastros_pendentes',
        'solicitacoes',
        'config_app',
        'fcm_tokens',
        'version'
      ];
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /valis/{docId} {
      allow read: if signedIn() && valisDocAllowed(docId);
      allow create, update: if signedIn() && valisDocAllowed(docId) && writeNotHuge();
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /panic_alerts/{alertId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid
            || (request.auth.token.role in ['dev', 'admin', 'supervisor', 'supervisao']));
      allow update: if signedIn()
        && (resource.data.uid == request.auth.uid
            || (request.auth.token.role in ['dev', 'admin', 'supervisor', 'supervisao']));
      allow delete: if signedIn()
        && request.auth.token.role in ['dev', 'admin'];
    }
  }
}
