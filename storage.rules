rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && (request.auth.token.role == 'dev' || request.auth.token.role == 'supervisao'); }

    // Fotos privadas por usuário. Supervisão/DEV precisam ter custom claim role.
    match /{folder}/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if signedIn() && (request.auth.uid == uid || admin());
    }
  }
}
